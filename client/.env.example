# PulseOps client environment — copy this file to `.env.local` and adjust.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so
# they must be present when `npm run build` runs.

# Express API base URL. `/register` uses NEXT_PUBLIC_EXPRESS_API_URL; the rest
# of the app (login/onboarding/dashboard) uses NEXT_PUBLIC_API_URL. Both fall
# back to http://localhost:5000 when unset. NOTE: this repo's server/.env sets
# PORT=3000, so local dev should point here at http://localhost:3000.
NEXT_PUBLIC_EXPRESS_API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# NextAuth base URL / session secret. NEXTAUTH_URL is optional in the App
# Router (the request host is used); NEXTAUTH_SECRET should be a long random
# string shared across the deployments that must decode the same sessions.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string

# OAuth provider credentials. NextAuth registers a provider ONLY when both the
# client id and secret are set — omit them (or leave empty) to disable that
# provider's Single Sign-On and fall back to email & password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
